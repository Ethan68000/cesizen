{% extends 'base.html.twig' %}

{% block title %}{{ ticket.title }} — CESIZen{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 fw-bold mb-0">{{ ticket.title }}</h1>
            {% if ticket.estCloture %}
                <span class="badge bg-secondary">Clôturé</span>
            {% else %}
                <span class="badge bg-success">Ouvert</span>
            {% endif %}
        </div>

        <div class="card-cesizen p-3 mb-3">
            <strong>Vous</strong>
            <p class="mb-1">{{ ticket.message }}</p>
            <small class="text-white-50">{{ ticket.createdAt|date('d/m/Y H:i') }}</small>
        </div>

        {% for reply in ticket.replies %}
            <div class="card-cesizen p-3 mb-3">
                <strong>{{ reply.fromAdmin ? 'Support CESIZen' : 'Vous' }}</strong>
                <p class="mb-1">{{ reply.content }}</p>
                <small class="text-white-50">{{ reply.createdAt|date('d/m/Y H:i') }}</small>
            </div>
        {% endfor %}

        {% if not ticket.estCloture %}
        <div class="form-cesizen shadow mt-4">
            {{ form_start(form) }}
                {{ form_widget(form.content, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.content) }}
                <button type="submit" class="btn btn-cesizen-primary mt-2">
                    <i class="bi bi-send me-2"></i>Répondre
                </button>
            {{ form_end(form) }}
        </div>

        {% if is_admin %}
            <form method="post" action="{{ path('app_ticket_close', {id: ticket.id}) }}"
                class="mt-3"
                onsubmit="return confirm('Clôturer ce ticket ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('close_ticket_' ~ ticket.id) }}">
                <button type="submit" class="btn btn-cesizen-danger">
                    <i class="bi bi-check-circle me-2"></i>Clôturer ce ticket
                </button>
            </form>
        {% endif %}
    {% else %}
        <p class="text-white-50 mt-3">Ce ticket est clôturé.</p>
    {% endif %}
    </div>
</div>
{% endblock %}
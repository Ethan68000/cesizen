{% extends 'base.html.twig' %}

{% block title %}Mes tickets — CESIZen{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold mb-0">
        <i class="bi bi-headset me-2"></i>Mes tickets
    </h1>
    <a href="{{ path('app_ticket_new') }}" class="btn btn-cesizen-primary">
        <i class="bi bi-plus-circle me-2"></i>Nouveau ticket
    </a>
</div>

{% if tickets is empty %}
    <div class="section-banner text-center">
        <p class="mb-0">Vous n'avez aucun ticket pour le moment.</p>
    </div>
{% else %}
    <div class="row g-3">
        {% for ticket in tickets %}
            <div class="col-md-6">
                <div class="card-cesizen p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="mb-1">{{ ticket.title }}</h5>
                        {% if ticket.estCloture %}
                            <span class="badge bg-secondary">Clôturé</span>
                        {% else %}
                            <span class="badge bg-success">Ouvert</span>
                        {% endif %}
                    </div>
                    <p class="mb-2 small">{{ ticket.message|slice(0, 100) }}{% if ticket.message|length > 100 %}...{% endif %}</p>
                    <small class="text-white-50">Créé le {{ ticket.createdAt|date('d/m/Y H:i') }}</small>
                    <div class="mt-2">
                        <a href="{{ path('app_ticket_show', {id: ticket.id}) }}" class="btn-cesizen btn btn-sm">
                            Voir le ticket
                        </a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}